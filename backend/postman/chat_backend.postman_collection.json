          "response": []
        },
        {
          "name": "Download the customer PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agent/api/v1/chat/attachments/{{pdfId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agent",
                "api",
                "v1",
                "chat",
                "attachments",
                "{{pdfId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Send a message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));\nconst d = pm.response.json().data;\npm.test('STAFF message', () => pm.expect(d.sender.type).to.eql('STAFF'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientMessageId\": \"{{$guid}}\",\n  \"type\": \"TEXT\",\n  \"text\": \"Received your payslip. Your repayment date is now the 25th.\"\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/agent/api/v1/chat/conversations/{{conversationId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agent",
                "api",
                "v1",
                "chat",
                "conversations",
                "{{conversationId}}",
                "messages"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Log out (ends the login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.unset('staffToken');",
                  "  pm.environment.unset('staffRefreshToken');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{staffRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agent/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agent",
                "api",
                "v1",
                "auth",
                [
                  "logout"
                ]
              ]
            },
            "description": "Revokes the login behind staffRefreshToken. Refresh then returns 401; the current staffToken still works until it expires."
          },
          "response": []
        }
      ],
      "description": "Run 1, 2 and 3 back to back (the handoff from step 2 is valid for 2 minutes), then any chat request. Repeat 1-3 when the session expires (15 minutes). The chat requests inherit Bearer {{staffToken}} from this folder.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{staffToken}}",
            "type": "string"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const isSignInStep = /^\\d\\. /.test(pm.info.requestName);",
              "if (!isSignInStep && !pm.environment.get('staffToken')) {",
              "  pm.variables.set('missingSession', 'No chat session yet: run \"Staff / 3. Chat session\" first (it saves staffToken)');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const missing = pm.variables.get('missingSession');",
              "if (missing) pm.test(missing, () => { throw new Error(missing); });"
            ]
          }
        }
      ]
    }
  ]
}
