NODE_ENV=development
PORT=3000

# Local Homebrew Postgres, using the postgres superuser (add :password after "postgres" if yours has one)
DATABASE_URL="postgresql://postgres@localhost:5432/chat_backend?schema=public"

# Comma-separated list of allowed origins (chat_web, and los_web if it calls us); leave empty to allow all in development
CORS_ORIGIN=

# --- LOS token verification (set ONE of the two key sources) ---
# Production: the LOS public key set
# LOS_JWKS_URI=https://api.los.delightech.asia/api/v1/guest/.well-known/jwks.json
# Local development: the public key made by `pnpm run dev:keys`
LOS_PUBLIC_KEY_PATH=keys/dev-los-public.pem
LOS_ISSUER=los-backend
LOS_CUSTOMER_AUDIENCE=luyleun
LOS_HANDOFF_AUDIENCE=chat
LOS_HANDOFF_TOKEN_TYPE=chat-handoff


# Signs chat_backend's own session tokens (customers and staff). Generate with: openssl rand -base64 48
CHAT_SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
CHAT_CUSTOMER_SESSION_EXPIRES_IN=1h
CHAT_STAFF_SESSION_EXPIRES_IN=15m

# Attachments (local disk driver)
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=20971520
