generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// Tracks the escalation state of a conversation between AI and human agents.
/// Maps to HandoffStatus in protocol.ts: "ai" | "needs-human" | "assigned"
enum HandoffStatus {
  AI
  NEEDS_HUMAN
  ASSIGNED
}

/// Identifies who sent a message.
/// Maps to MessageSide in protocol.ts: "customer" | "assistant" | "agent"
enum MessageSide {
  CUSTOMER
  ASSISTANT
  AGENT
}

/// Delivery/read status of a message (mirrors DeliveryStatus in protocol.ts).
enum DeliveryStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Visual tone for activity timeline entries (maps to ActivityDto.tone).
enum ActivityTone {
  BLUE
  CYAN
  RED
}

/// Lifecycle of a conversation, independent of who is handling it (handoff).
enum ConversationStatus {
  OPEN
  RESOLVED
  CLOSED
}

/// Kind of content carried by a message.
enum MessageType {
  TEXT
  IMAGE
  FILE
  NOTE /// internal agent note, never delivered to the customer
  SYSTEM /// e.g. "Agent X took over"
}

/// File classification in the media/shared-files panel.
enum FileKind {
  DOCUMENT
  IMAGE
}

/// Role of an agent within an assignment (owner vs. read-only observer).
enum AssignmentRole {
  OWNER
  VIEWER
}

/// Push transport of a registered device (FCM for Android, APNs for iOS).
enum DevicePlatform {
  ANDROID
  IOS
}

/// Category of a system notification delivered to an agent.
enum NotificationType {
  NEW_CONVERSATION
  HANDOFF
  CALLBACK
  MENTION
  SYSTEM
}

// ─── Core Entities ──────────────────────────────────────────────────────────
//
// This service (Backend 2, the chat backend) owns chat data only. Identity, users, agents,
// customers, loan applications and authentication belong to Backend 1 (the main backend).
// Columns named customerId / applicationId / agentId / userId / senderUserId hold Backend 1
// ids as opaque strings with NO foreign key: they cannot be enforced across databases, and
// the id format is defined by Backend 1 (not yet known, so VarChar(64) rather than Uuid).
// Names, avatars, roles and loan details are fetched from Backend 1, never copied here.

/// A chat conversation between a customer and one or more agents/AI.
/// ConversationDto is composed from this table + Activity[] + customer/application
/// details fetched from Backend 1.
model Conversation {
  id              String             @id @default(uuid()) @db.Uuid
  slug            String             @unique @db.VarChar(100) /// e.g. "maya" (external id the WS protocol/frontend uses today)
  customerId      String             @map("customer_id") @db.VarChar(64) /// Backend 1 customer id
  status          ConversationStatus @default(OPEN)
  channel         String             @default("web") @db.VarChar(32) /// web | telegram | ...
  closedAt        DateTime?          @map("closed_at")
  applicationId   String?            @unique @map("application_id") @db.VarChar(64) /// Backend 1 loan application id; one conversation per application
  preview         String             @db.VarChar(255) /// Last message preview (ConversationDto.preview)
  lastMessageAt   DateTime           @map("last_message_at") /// ConversationDto.lastMessageAt
  unreadCount     Int                @default(0) @map("unread_count") /// ConversationDto.unread
  urgent          Boolean            @default(false) /// ConversationDto.urgent
  handoff         HandoffStatus      @default(AI) /// ConversationDto.handoff
  assignedAgentId String?            @map("assigned_agent_id") @db.VarChar(64) /// Backend 1 agent id of the current owner (HandoffStatus.ASSIGNED)
  summary         String?            @db.Text /// ConversationDto.summary
  summaryImage    String?            @map("summary_image") @db.VarChar(512) /// ConversationDto.summaryImage
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  messages         Message[]
  activities       Activity[]
  agentAssignments AgentConversation[]
  reads            ConversationRead[]
  files            SharedFile[]

  @@index([handoff, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
  @@index([urgent, handoff])
  @@index([customerId])
  @@index([assignedAgentId])
  @@map("conversations")
}

/// An individual message within a conversation.
/// Maps to ChatMessageDto; senderUserId is a Backend 1 id (customer or agent).
/// For ASSISTANT messages (AI), senderUserId is NULL.
model Message {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  senderType     MessageSide     @default(CUSTOMER) @map("sender_type")
  senderUserId   String?         @map("sender_user_id") @db.VarChar(64) /// Backend 1 id of the customer or agent; NULL for ASSISTANT
  type           MessageType     @default(TEXT)
  text           String          @db.Text
  clientId       String?         @map("client_id") @db.VarChar(64) /// client-generated id for optimistic sends (idempotency key)
  status         DeliveryStatus? @default(SENT) /// sender-facing status; per-recipient detail is in MessageReceipt
  createdAt      DateTime        @default(now()) @map("created_at")
  editedAt       DateTime?       @map("edited_at")
  deletedAt      DateTime?       @map("deleted_at") /// soft delete; never hard-delete messages

  files    SharedFile[]
  receipts MessageReceipt[]

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientId]) /// retry after reconnect must not duplicate
  @@index([conversationId, createdAt])
  @@index([conversationId, status])
  @@index([senderUserId])
  @@map("messages")
}

/// A timeline/activity event attached to a conversation.
/// Maps to ActivityDto (tone, title, time, copy).
model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  agentId        String?      @map("agent_id") @db.VarChar(64) /// Backend 1 agent id. Nullable — many activities are system/AI generated
  tone           ActivityTone
  title          String       @db.VarChar(255)
  copy           String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") /// DTO "time" is derived from this

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("activities")
}

/// Tracks the assignment history of agents to conversations.
/// Every takeover / handoff creates a new row (closing the previous one).
/// Enables audit of who owned which conversation and when.
model AgentConversation {
  id             String         @id @default(uuid()) @db.Uuid
  agentId        String         @map("agent_id") @db.VarChar(64) /// Backend 1 agent id
  conversationId String         @map("conversation_id") @db.Uuid
  role           AssignmentRole @default(OWNER)
  assignedAt     DateTime       @default(now()) @map("assigned_at")
  unassignedAt   DateTime?      @map("unassigned_at")

  /// Restrict: assignment history is an audit trail that shouldn't vanish with a chat.
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([conversationId, assignedAt])
  @@index([agentId])
  @@map("agent_conversations")
}

/// A file shared in a conversation (media, documents).
/// SharedFile in share-files/model/store.ts is currently a disconnected local
/// store; this table links files to conversations, customers, and applications.
model SharedFile {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  customerId     String   @map("customer_id") @db.VarChar(64) /// Backend 1 customer id
  applicationId  String?  @map("application_id") @db.VarChar(64) /// Backend 1 loan application id
  name           String   @db.VarChar(255)
  kind           FileKind
  messageId      String?  @map("message_id") @db.Uuid /// message the file was sent with, if any
  sizeBytes      Int      @map("size_bytes") /// DTO formats as "1.8 MB"
  mimeType       String?  @map("mime_type") @db.VarChar(127)
  storageKey     String   @map("storage_key") @db.VarChar(512) /// object key in the bucket; download URLs are derived/signed from this
  url            String?  @db.VarChar(1024) /// optional cached public URL (signed URLs expire, so do not rely on it)
  checksumSha256 String?  @map("checksum_sha256") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") /// DTO "addedAt" is derived from this

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([customerId])
  @@index([messageId])
  @@map("shared_files")
}

/// A persistent agent preference (settings). Also read when deciding whether to push (flow I).
/// Message settings and privacy controls currently live only in Zustand stores.
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @map("agent_id") @db.VarChar(64) /// Backend 1 agent id
  key       String   @db.VarChar(100) /// e.g. "conversationAlerts", "readReceipts", "aiReplies"
  value     Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")


  @@unique([agentId, key])
  @@map("settings")
}

/// A system notification for an agent.
/// The Notifications feature (features/notifications/) is a placeholder;
/// this table backs it with persisted, queryable data.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  agentId   String           @map("agent_id") @db.VarChar(64) /// Backend 1 agent id
  type      NotificationType @default(SYSTEM)
  text      String           @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")


  @@index([agentId, read])
  @@index([createdAt])
  @@map("notifications")
}

/// Per-user read position in a conversation. conversations.unread_count stays
/// as the shared inbox badge; this table gives each agent their own unread state.
model ConversationRead {
  userId         String   @map("user_id") @db.VarChar(64) /// Backend 1 user id
  conversationId String   @map("conversation_id") @db.Uuid
  lastReadAt     DateTime @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
  @@map("conversation_reads")
}

/// Per-recipient delivery and read receipt (flows D/E). Message.status is the
/// sender-facing summary; this table records who received/read it and when.
model MessageReceipt {
  messageId   String    @map("message_id") @db.Uuid
  userId      String    @map("user_id") @db.VarChar(64) /// Backend 1 id of the recipient
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_receipts")
}

/// A mobile device registered for push notifications (FCM / APNs). Used when the
/// recipient is offline and their notification settings allow it (flow I).
model DeviceToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.VarChar(64) /// Backend 1 user id
  platform  DevicePlatform
  token     String         @unique @db.VarChar(512) /// FCM registration token or APNs device token
  revokedAt DateTime?      @map("revoked_at") /// set when the provider reports the token invalid
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@map("device_tokens")
}

// ─── Composition (not managed by Prisma) ───────────────────────────────────

/// The WebSocket `sync` event returns `ConversationDto[]`. It is composed in the service layer:
/// conversation rows from this database (inbox fields, handoff, activities) plus customer
/// name/avatar and loan application details fetched from Backend 1 by `customerId` and
/// `applicationId`. There is no SQL view, because that data is not in this database.
