// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChatUserKind {
  CUSTOMER
  STAFF

  @@map("chat_user_kind")
}

enum SenderKind {
  CUSTOMER
  STAFF

  @@map("sender_kind")
}

enum MessageType {
  TEXT
  VOICE
  IMAGE
  FILE

  @@map("message_type")
}

// Known roles — mirrors LOS role names; seeded at migration time, not managed via CRUD
model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  kind        ChatUserKind
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  chatUsers   ChatUser[]
  permissions RolePermission[]

  @@map("roles")
}

// Static chat permission pairs (module + action); seeded, never CRUDed
model Permission {
  id        Int              @id @default(autoincrement())
  module    String
  action    String
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  roles     RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

// Which permissions are attached to which role
model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// Everyone who has used chat, keyed by their LOS identity (LOS owns the accounts)
model ChatUser {
  id         String       @id @default(uuid()) @db.Uuid
  losUserId  Int          @map("los_user_id")
  kind       ChatUserKind
  username   String
  roleId     Int          @map("role_id")
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  lastSeenAt DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation?
  messages     Message[]
  attachments  Attachment[]

  @@unique([losUserId, kind])
  @@map("chat_users")
}

// One permanent thread per customer; every staff member can read and reply to it
model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  customerId    String    @unique @map("customer_id") @db.Uuid
  customer      ChatUser  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  messages Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id              String       @id @default(uuid()) @db.Uuid
  // * Insert order: rows written in one transaction can share created_at, so history is sorted by seq
  seq             Int          @unique @default(autoincrement())
  conversationId  String       @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderId        String       @map("sender_id") @db.Uuid
  sender          ChatUser     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  senderKind      SenderKind   @map("sender_kind")
  type            MessageType
  text            String?
  attachmentId    String?      @unique @map("attachment_id") @db.Uuid
  attachment      Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  clientMessageId String?      @map("client_message_id")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, seq])
  @@map("messages")
}

// Uploaded first, then sent in a message
model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  uploaderId  String   @map("uploader_id") @db.Uuid
  uploader    ChatUser @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  storageKey  String   @unique @map("storage_key")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  fileName    String   @map("file_name")
  durationSec Int?     @map("duration_sec")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message?

  @@map("attachments")
}
