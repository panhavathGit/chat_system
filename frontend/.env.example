# Copy to frontend/.env (git-ignored). Restart `pnpm dev` after editing.

# "chat-backend" = real chat_backend API + Socket.io. Anything else (or unset) = in-browser mock, no backend needed.
VITE_TRANSPORT=chat-backend

# chat_backend base URL (backend PORT, default 3000)
VITE_CHAT_API_URL=http://localhost:3000

# "standalone" = sign in with an LOS staff username + password (local development).
# "embedded"   = running as an iframe inside los_web, which passes a handoff token by postMessage.
VITE_AUTH_MODE=standalone

# LOS dev API host including /api/v1, e.g. https://api-dev.los.delightech.asia/api/v1
VITE_LOS_API_URL=

# LOS endpoint that issues the staff handoff token
# (the chat one, /admin/chat/handoff-token, once LOS ships it)
VITE_LOS_HANDOFF_PATH=/admin/dashboard-embed/handoff-token

# los_web origin; required only when VITE_AUTH_MODE=embedded
VITE_LOS_WEB_ORIGIN=
