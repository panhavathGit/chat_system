// Mirrors backend/prisma/schema.prisma (PostgreSQL 16+).
// Chat backend (Backend 2) only. Backend 1 ids (customer_id, application_id, agent_id, user_id) are external: no FK.

Project chat_dashboard {
  database_type: 'PostgreSQL'
  Note: 'Loan-application support chat with AI to human handoff'
}

// ─── Enums ──────────────────────────────────────────────────────────

Enum handoff_status {
  AI
  NEEDS_HUMAN
  ASSIGNED
}

Enum conversation_status {
  OPEN
  RESOLVED
  CLOSED
}

Enum message_side {
  CUSTOMER
  ASSISTANT
  AGENT
}

Enum message_type {
  TEXT
  IMAGE
  FILE
  NOTE [note: 'internal agent note, never sent to the customer']
  SYSTEM [note: 'e.g. Agent X took over']
}

Enum delivery_status {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

Enum activity_tone {
  BLUE
  CYAN
  RED
}

Enum file_kind {
  DOCUMENT
  IMAGE
}

Enum assignment_role {
  OWNER
  VIEWER
}

Enum device_platform {
  ANDROID
  IOS
}

Enum notification_type {
  NEW_CONVERSATION
  HANDOFF
  CALLBACK
  MENTION
  SYSTEM
}

// ─── Tables ─────────────────────────────────────────────────────────

Table conversations {
  id                char(36) [pk]
  slug              varchar(100) [not null, unique, note: 'external id used by the WS protocol/frontend, e.g. maya']
  customer_id       varchar(64) [not null, note: 'Backend 1 customer id']
  status            conversation_status [not null, default: 'OPEN']
  channel           varchar(32) [not null, default: 'web']
  closed_at         datetime [note: 'NULL <=> status = OPEN']
  application_id    varchar(64) [unique, note: 'Backend 1 loan application id']
  preview           varchar(255) [not null, note: 'denormalized last message preview']
  last_message_at   datetime [not null]
  unread_count      int [not null, default: 0]
  urgent            boolean [not null, default: false]
  handoff           handoff_status [not null, default: 'AI']
  assigned_agent_id varchar(64) [note: 'Backend 1 agent id; current owner when handoff = ASSIGNED']
  summary           text
  summary_image     varchar(512)
  created_at        datetime [not null, default: `now()`]
  updated_at        datetime [not null, default: `now()`]

  indexes {
    handoff
    last_message_at
    (urgent, handoff)
    (status, last_message_at)
    customer_id
    assigned_agent_id
  }
}

Table messages {
  id                 char(36) [pk]
  conversation_id    char(36) [not null, ref: > conversations.id]
  sender_type        message_side [not null, default: 'CUSTOMER']
  sender_user_id     varchar(64) [note: 'Backend 1 id; NULL for ASSISTANT']
  type               message_type [not null, default: 'TEXT']
  text               text [not null]
  client_id          varchar(64) [note: 'client-generated id for optimistic sends (idempotency)']
  status             delivery_status [default: 'SENT']
  created_at         datetime [not null, default: `now()`]
  edited_at          datetime
  deleted_at         datetime [note: 'soft delete']

  indexes {
    (conversation_id, created_at)
    (conversation_id, status)
    sender_user_id
    text [note: 'GIN to_tsvector index in constraints.sql']
    (conversation_id, client_id) [unique]
  }
}

Table activities {
  id              char(36) [pk, default: `uuid()`]
  conversation_id char(36) [not null, ref: > conversations.id]
  agent_id        varchar(64) [note: 'Backend 1 agent id; NULL for system/AI events']
  tone            activity_tone [not null]
  title           varchar(255) [not null]
  copy            text [not null]
  created_at      datetime [not null, default: `now()`]

  indexes {
    (conversation_id, created_at)
  }
}

Table agent_conversations {
  id              char(36) [pk]
  agent_id        varchar(64) [not null, note: 'Backend 1 agent id']
  conversation_id char(36) [not null, ref: > conversations.id]
  role            assignment_role [not null, default: 'OWNER']
  assigned_at     datetime [not null, default: `now()`]
  unassigned_at   datetime [note: 'NULL = currently assigned']

  indexes {
    (conversation_id, assigned_at)
    agent_id
  }

  Note: 'Append-only assignment history; FKs are RESTRICT so history survives. conversations.handoff = ASSIGNED <=> assigned_agent_id is set (CHECK). One active OWNER per conversation via a partial UNIQUE index (backend/prisma/sql/constraints.sql).'
}

Table shared_files {
  id              char(36) [pk]
  conversation_id char(36) [not null, ref: > conversations.id]
  customer_id     varchar(64) [not null, note: 'Backend 1 customer id']
  application_id  varchar(64) [note: 'Backend 1 loan application id']
  message_id      char(36) [ref: > messages.id, note: 'message the file was sent with']
  name            varchar(150) [not null]
  kind            file_kind [not null]
  size_bytes      int [not null]
  mime_type       varchar(127)
  storage_key     varchar(512) [not null, note: 'object key; download URLs are derived/signed from it']
  url             varchar(1024) [note: 'optional cached public URL']
  checksum_sha256 char(64)
  created_at      datetime [not null, default: `now()`]

  indexes {
    conversation_id
    customer_id
    message_id
  }
}

Table settings {
  id         char(36) [pk]
  agent_id   varchar(64) [not null, note: 'Backend 1 agent id']
  key        varchar(100) [not null, note: 'e.g. readReceipts, aiReplies']
  value      boolean [not null, default: false]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (agent_id, key) [unique]
  }
}

Table notifications {
  id         char(36) [pk]
  agent_id   varchar(64) [not null, note: 'Backend 1 agent id']
  type       notification_type [not null, default: 'SYSTEM']
  text       text [not null]
  read       boolean [not null, default: false]
  created_at datetime [not null, default: `now()`]

  indexes {
    (agent_id, read)
    created_at
  }
}

Table conversation_reads {
  user_id         varchar(64) [not null, note: 'Backend 1 user id']
  conversation_id char(36) [not null, ref: > conversations.id]
  last_read_at    datetime [not null]

  indexes {
    (user_id, conversation_id) [pk]
    conversation_id
  }

  Note: 'Per-user read position. conversations.unread_count stays as the shared inbox badge.'
}

Table message_receipts {
  message_id   char(36) [not null, ref: > messages.id]
  user_id      varchar(64) [not null, note: 'Backend 1 id of the recipient']
  delivered_at datetime
  read_at      datetime

  indexes {
    (message_id, user_id) [pk]
    user_id
  }

  Note: 'Per-recipient delivery/read receipts. messages.status is the sender-facing summary.'
}

Table device_tokens {
  id         char(36) [pk]
  user_id    varchar(64) [not null, note: 'Backend 1 user id']
  platform   device_platform [not null]
  token      varchar(512) [not null, unique, note: 'FCM registration token or APNs device token']
  revoked_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    user_id
  }

  Note: 'Push targets (flow I).'
}
