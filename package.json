{
  "name": "chat-system",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --filter @chat-system/frontend dev",
    "build": "pnpm -r build",
    "dev:backend": "pnpm --filter @chat-system/backend dev",
    "preview": "pnpm --filter @chat-system/frontend preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "check:fsd": "pnpm -r check:fsd",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "check": "pnpm typecheck && pnpm lint && pnpm check:fsd && pnpm format:check && pnpm test",
    "db:generate": "pnpm --filter @chat-system/backend db:generate",
    "db:validate": "pnpm --filter @chat-system/backend db:validate",
    "db:migrate": "pnpm --filter @chat-system/backend db:migrate"
  },
  "devDependencies": {
    "prettier": "3"
  },
  "packageManager": "pnpm@10.34.3"
}
